@FCG.Users.Api_HostAddress = http://localhost:5260
@Token = replace-with-access-token

GET {{FCG.Users.Api_HostAddress}}/
Accept: application/json

###

GET {{FCG.Users.Api_HostAddress}}/health
Accept: application/json

###

